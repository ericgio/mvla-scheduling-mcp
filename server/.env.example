# --- Byga field availability (required for get_field_availability tool) ---

# Set to "true" only if you have Byga API access configured
# ENABLE_FIELD_AVAILABILITY=true

# Base URL of your club's Byga instance (e.g. https://yourclub.byga.net)
# schedule_id and team_id are passed directly to the tool, not set here.
BYGA_BASE_URL=

# --- Server mode (optional) ---

# Transport: "stdio" (default, for Claude Desktop) or "http" (for shared/hosted use)
# In http mode, get_field_availability is disabled.
MCP_TRANSPORT=stdio

# Port for HTTP mode (default: 3001)
PORT=3001

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info
